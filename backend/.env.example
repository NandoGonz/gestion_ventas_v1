# Copia este archivo a backend/.env y sustituye los valores de ejemplo.
APP_ENV=development
APP_NAME=Sistema de Gestión de Ventas
APP_JWT_SECRET=GENERA_UN_SECRETO_ALEATORIO_LARGO
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_ISSUER=gestion-ventas
JWT_AUDIENCE=gestion-ventas-api

# Para ejecutar FastAPI localmente en Windows/PostgreSQL instalado en tu equipo.
# Sustituye CAMBIAR_PASSWORD por la contraseña real de tu usuario PostgreSQL.
# Si la contraseña contiene caracteres especiales (@, :, /, #, %), codifícala para URL.
DATABASE_URL=postgresql+psycopg2://postgres:CAMBIAR_PASSWORD@localhost:5432/proyecto-dev

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_CREATE_TABLES=true
BOOTSTRAP_ADMIN_NAME=Emiro José González Rivera
BOOTSTRAP_ADMIN_EMAIL=adminemiro@version1.com
# Introduce la contraseña inicial local de forma privada; no la subas a Git.
BOOTSTRAP_ADMIN_PASSWORD=
